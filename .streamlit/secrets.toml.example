# Copie este arquivo para .streamlit/secrets.toml e preencha com suas credenciais reais.
# O arquivo secrets.toml está no .gitignore e NÃO deve ser enviado ao GitHub.

[database]
url = "postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "gere-uma-chave-secreta-aleatoria-aqui"
client_id = "SEU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "SEU_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
